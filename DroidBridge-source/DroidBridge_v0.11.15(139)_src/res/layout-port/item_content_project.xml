<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    android:focusable="false"
    android:clickable="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8.0dip"
    android:foreground="?selectableItemBackground"
    app:cardBackgroundColor="@color/launcher_card"
    app:cardCornerRadius="16.0dip"
    app:cardElevation="0.0dip"
    app:strokeColor="?colorOutlineVariant"
    app:strokeWidth="1.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:padding="10.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@id/imageProjectIcon"
                android:background="@drawable/bg_content_project_icon"
                android:padding="5.0dip"
                android:layout_width="50.0dip"
                android:layout_height="50.0dip"
                android:src="@drawable/ic_content_mod_24"
                android:scaleType="centerCrop"
                android:contentDescription="@string/content_browser_project_icon_description"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay_DroidBridge_ProjectIcon" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_marginStart="10.0dip">
                <TextView
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:id="@id/textProjectName"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2" />
                <TextView
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:ellipsize="end"
                    android:id="@id/textProjectAuthor"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.0dip"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:ellipsize="end"
            android:id="@id/textProjectDescription"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6.0dip"
            android:maxLines="2" />
        <TextView
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:ellipsize="end"
            android:id="@id/textProjectTags"
            android:background="@drawable/bg_content_browser_chip"
            android:paddingTop="3.0dip"
            android:paddingBottom="3.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6.0dip"
            android:maxLines="1"
            android:paddingStart="8.0dip"
            android:paddingEnd="8.0dip" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.0dip">
            <ImageView
                android:layout_width="15.0dip"
                android:layout_height="15.0dip"
                android:src="@drawable/ic_download_24"
                app:tint="?colorOnSurfaceVariant" />
            <TextView
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:id="@id/textProjectDownloads"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4.0dip" />
            <ImageView
                android:layout_width="15.0dip"
                android:layout_height="15.0dip"
                android:src="@drawable/ic_favorite_24"
                android:layout_marginStart="10.0dip"
                app:tint="?colorOnSurfaceVariant" />
            <TextView
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:id="@id/textProjectLikes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4.0dip" />
            <Space
                android:layout_width="0.0dip"
                android:layout_height="1.0dip"
                android:layout_weight="1.0" />
            <ImageView
                android:layout_width="15.0dip"
                android:layout_height="15.0dip"
                android:src="@drawable/ic_history_24"
                app:tint="?colorOnSurfaceVariant" />
            <TextView
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:ellipsize="end"
                android:id="@id/textProjectUpdated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="4.0dip" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.0dip">
            <ImageView
                android:id="@id/imageProjectInstalledSource"
                android:padding="2.0dip"
                android:visibility="gone"
                android:layout_width="20.0dip"
                android:layout_height="20.0dip"
                android:scaleType="centerInside"
                android:contentDescription="@string/modmanager_installed_source_icon"
                android:layout_marginEnd="8.0dip" />
            <com.google.android.material.button.MaterialButton
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:id="@id/buttonInstallProject"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:minWidth="0.0dip"
                android:minHeight="44.0dip"
                android:text="@string/content_browser_install"
                android:layout_weight="1.0"
                android:insetTop="0.0dip"
                android:insetBottom="0.0dip"
                android:paddingStart="10.0dip"
                android:paddingEnd="10.0dip"
                android:elevation="0.0dip"
                android:stateListAnimator="@null"
                app:icon="@drawable/ic_add_24"
                style="@style/Widget.Material3.Button.OutlinedButton" />
            <com.google.android.material.button.MaterialButton
                android:id="@id/buttonProjectMenu"
                android:padding="0.0dip"
                android:layout_width="44.0dip"
                android:layout_height="44.0dip"
                android:minWidth="44.0dip"
                android:minHeight="44.0dip"
                android:insetTop="0.0dip"
                android:insetBottom="0.0dip"
                android:contentDescription="@string/content_browser_project_menu"
                android:layout_marginStart="6.0dip"
                android:elevation="0.0dip"
                android:stateListAnimator="@null"
                app:icon="@drawable/ic_more_vert_24"
                app:iconGravity="textStart"
                app:iconPadding="0.0dip"
                style="@style/Widget.Material3.Button.TextButton" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>