<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@id/mainContent"
    android:background="?android:colorBackground"
    android:padding="0.0dip"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.card.MaterialCardView
        android:id="@id/mainviewcardview"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0.0dip"
        app:cardUseCompatPadding="false"
        app:strokeWidth="0.0dip">
        <FrameLayout
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:orientation="vertical"
                android:clipToPadding="false"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <com.google.android.material.card.MaterialCardView
                    android:id="@id/cardMainTabsHeader"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10.0dip"
                    android:layout_marginStart="10.0dip"
                    android:layout_marginEnd="10.0dip"
                    app:cardBackgroundColor="?colorSurface"
                    app:cardCornerRadius="20.0dip"
                    app:cardElevation="0.0dip"
                    app:cardUseCompatPadding="false"
                    app:strokeColor="?colorOutlineVariant"
                    app:strokeWidth="1.0dip">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@id/installinstanceslayout"
                        android:paddingTop="6.0dip"
                        android:paddingBottom="6.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="14.0dip"
                        android:paddingEnd="10.0dip">
                        <TextView
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textStyle="bold"
                            android:ellipsize="end"
                            android:id="@id/textMainInstancesTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/main_instances"
                            android:maxLines="1"
                            android:layout_marginEnd="14.0dip" />
                        <com.google.android.material.tabs.TabLayout
                            android:id="@id/tabVersionTypes"
                            android:background="@android:color/transparent"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0"
                            app:tabGravity="start"
                            app:tabIndicatorFullWidth="false"
                            app:tabMinWidth="60.0dip"
                            app:tabMode="scrollable"
                            app:tabPaddingEnd="12.0dip"
                            app:tabPaddingStart="12.0dip" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@id/buttonMultiSelectInstances"
                            android:padding="0.0dip"
                            android:visibility="gone"
                            android:layout_width="48.0dip"
                            android:layout_height="44.0dip"
                            android:minWidth="48.0dip"
                            android:minHeight="44.0dip"
                            android:text=""
                            android:insetTop="0.0dip"
                            android:insetBottom="0.0dip"
                            android:contentDescription="@string/button_delete_selected_instances"
                            android:layout_marginEnd="6.0dip"
                            android:elevation="0.0dip"
                            android:stateListAnimator="@null"
                            app:icon="@drawable/ic_delete_24"
                            app:iconGravity="textStart"
                            app:iconPadding="0.0dip"
                            style="@style/Widget.Material3.Button.OutlinedButton" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@id/buttonStorageLocations"
                            android:padding="0.0dip"
                            android:layout_width="48.0dip"
                            android:layout_height="44.0dip"
                            android:minWidth="48.0dip"
                            android:minHeight="44.0dip"
                            android:text=""
                            android:insetTop="0.0dip"
                            android:insetBottom="0.0dip"
                            android:contentDescription="@string/storage_locations_title"
                            android:elevation="0.0dip"
                            android:stateListAnimator="@null"
                            app:icon="@drawable/ic_folder_24"
                            app:iconGravity="textStart"
                            app:iconPadding="0.0dip"
                            style="@style/Widget.Material3.Button.OutlinedButton" />
                        <Space
                            android:layout_width="8.0dip"
                            android:layout_height="wrap_content" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@id/buttonOpenSettings"
                            android:padding="0.0dip"
                            android:layout_width="48.0dip"
                            android:layout_height="44.0dip"
                            android:minWidth="48.0dip"
                            android:minHeight="44.0dip"
                            android:text=""
                            android:insetTop="0.0dip"
                            android:insetBottom="0.0dip"
                            android:contentDescription="@string/button_settings"
                            android:elevation="0.0dip"
                            android:stateListAnimator="@null"
                            app:icon="@drawable/ic_settings_24"
                            app:iconGravity="textStart"
                            app:iconPadding="0.0dip"
                            style="@style/Widget.Material3.Button.OutlinedButton" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <View
                    android:id="@id/viewMainTopBarShadow"
                    android:background="@drawable/bg_main_top_bar_shadow"
                    android:layout_width="fill_parent"
                    android:layout_height="2.0dip"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="10.0dip"
                    android:layout_marginEnd="10.0dip" />
                <FrameLayout
                    android:clipToPadding="false"
                    android:layout_width="fill_parent"
                    android:layout_height="0.0dip"
                    android:layout_weight="1.0">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@id/recyclerVersions"
                        android:paddingTop="16.0dip"
                        android:paddingBottom="16.0dip"
                        android:clipToPadding="false"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:overScrollMode="ifContentScrolls"
                        android:paddingStart="10.0dip"
                        android:paddingEnd="10.0dip"
                        android:nestedScrollingEnabled="true" />
                    <ProgressBar
                        android:layout_gravity="top"
                        android:id="@id/progressVersions"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        style="?android:progressBarStyleHorizontal" />
                </FrameLayout>
                <View
                    android:id="@id/viewMainBottomBarShadow"
                    android:background="@drawable/bg_main_bottom_bar_shadow"
                    android:layout_width="fill_parent"
                    android:layout_height="2.0dip"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="10.0dip"
                    android:layout_marginEnd="10.0dip" />
                <com.google.android.material.card.MaterialCardView
                    android:id="@id/cardMainBottomActions"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10.0dip"
                    android:layout_marginStart="10.0dip"
                    android:layout_marginEnd="10.0dip"
                    app:cardBackgroundColor="?colorSurface"
                    app:cardCornerRadius="20.0dip"
                    app:cardElevation="0.0dip"
                    app:cardUseCompatPadding="false"
                    app:strokeColor="?colorOutlineVariant"
                    app:strokeWidth="1.0dip">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@id/bottomMainActions"
                        android:padding="10.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <HorizontalScrollView
                                android:scrollbars="none"
                                android:clipToPadding="false"
                                android:layout_width="0.0dip"
                                android:layout_height="wrap_content"
                                android:fillViewport="false"
                                android:layout_weight="1.0"
                                android:overScrollMode="ifContentScrolls">
                                <LinearLayout
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">
                                    <ImageView
                                        android:id="@id/imageMainPlayerHead"
                                        android:background="@drawable/bg_player_head_preview"
                                        android:padding="4.0dip"
                                        android:focusable="true"
                                        android:clickable="true"
                                        android:layout_width="44.0dip"
                                        android:layout_height="44.0dip"
                                        android:src="@drawable/ic_player_head_placeholder"
                                        android:scaleType="fitXY"
                                        android:adjustViewBounds="true"
                                        android:contentDescription="@string/main_player_head_signed_out"
                                        android:layout_marginEnd="10.0dip" />
                                    <com.google.android.material.button.MaterialButton
                                        android:textStyle="bold"
                                        android:id="@id/buttonShareLatestLog"
                                        android:padding="8.0dip"
                                        android:layout_width="wrap_content"
                                        android:layout_height="44.0dip"
                                        android:minWidth="48.0dip"
                                        android:minHeight="44.0dip"
                                        android:text="@string/button_share_logs"
                                        android:insetTop="0.0dip"
                                        android:insetBottom="0.0dip"
                                        android:contentDescription="@string/button_share_logs"
                                        android:elevation="0.0dip"
                                        android:stateListAnimator="@null"
                                        app:icon="@drawable/ic_share_24"
                                        app:iconGravity="textStart"
                                        app:iconPadding="0.0dip"
                                        style="@style/Widget.Material3.Button.OutlinedButton" />
                                    <Space
                                        android:layout_width="12.0dip"
                                        android:layout_height="wrap_content" />
                                    <com.google.android.material.button.MaterialButton
                                        android:ellipsize="end"
                                        android:id="@id/buttonBrowseModsMain"
                                        android:layout_width="wrap_content"
                                        android:layout_height="44.0dip"
                                        android:minWidth="96.0dip"
                                        android:minHeight="44.0dip"
                                        android:text="@string/main_mods"
                                        android:maxLines="1"
                                        android:insetTop="0.0dip"
                                        android:insetBottom="0.0dip"
                                        android:elevation="0.0dip"
                                        android:stateListAnimator="@null"
                                        app:icon="@drawable/ic_content_mod_24"
                                        app:iconGravity="textStart"
                                        app:iconPadding="8.0dip"
                                        style="@style/Widget.Material3.Button.OutlinedButton" />
                                    <Space
                                        android:layout_width="8.0dip"
                                        android:layout_height="wrap_content" />
                                    <com.google.android.material.button.MaterialButton
                                        android:ellipsize="end"
                                        android:id="@id/buttonBrowseContentMain"
                                        android:layout_width="wrap_content"
                                        android:layout_height="44.0dip"
                                        android:minWidth="132.0dip"
                                        android:minHeight="44.0dip"
                                        android:text="@string/main_browse_modpacks"
                                        android:maxLines="1"
                                        android:insetTop="0.0dip"
                                        android:insetBottom="0.0dip"
                                        android:elevation="0.0dip"
                                        android:stateListAnimator="@null"
                                        app:icon="@drawable/ic_browse_modpacks_24"
                                        app:iconGravity="textStart"
                                        app:iconPadding="8.0dip"
                                        style="@style/Widget.Material3.Button.OutlinedButton" />
                                    <Space
                                        android:layout_width="8.0dip"
                                        android:layout_height="wrap_content" />
                                    <com.google.android.material.button.MaterialButton
                                        android:ellipsize="end"
                                        android:id="@id/buttonImportModpackMain"
                                        android:layout_width="wrap_content"
                                        android:layout_height="44.0dip"
                                        android:minWidth="126.0dip"
                                        android:minHeight="44.0dip"
                                        android:text="@string/main_import_modpack"
                                        android:maxLines="1"
                                        android:insetTop="0.0dip"
                                        android:insetBottom="0.0dip"
                                        android:elevation="0.0dip"
                                        android:stateListAnimator="@null"
                                        app:icon="@drawable/ic_import_modpack_24"
                                        app:iconGravity="textStart"
                                        app:iconPadding="8.0dip"
                                        style="@style/Widget.Material3.Button.OutlinedButton" />
                                    <Space
                                        android:layout_width="8.0dip"
                                        android:layout_height="wrap_content" />
                                    <com.google.android.material.button.MaterialButton
                                        android:id="@id/buttonRefreshVersions"
                                        android:padding="0.0dip"
                                        android:layout_width="48.0dip"
                                        android:layout_height="44.0dip"
                                        android:minWidth="48.0dip"
                                        android:minHeight="44.0dip"
                                        android:text=""
                                        android:insetTop="0.0dip"
                                        android:insetBottom="0.0dip"
                                        android:contentDescription="@string/button_refresh_versions"
                                        android:elevation="0.0dip"
                                        android:stateListAnimator="@null"
                                        app:icon="@drawable/ic_refresh_24"
                                        app:iconGravity="textStart"
                                        app:iconPadding="0.0dip"
                                        style="@style/Widget.Material3.Button.OutlinedButton" />
                                </LinearLayout>
                            </HorizontalScrollView>
                            <Space
                                android:layout_width="10.0dip"
                                android:layout_height="wrap_content" />
                            <com.google.android.material.floatingactionbutton.FloatingActionButton
                                android:id="@id/fabCreateInstance"
                                android:layout_width="44.0dip"
                                android:layout_height="44.0dip"
                                android:contentDescription="@string/create_instance_button"
                                app:backgroundTint="?colorPrimary"
                                app:borderWidth="0.0dip"
                                app:elevation="0.0dip"
                                app:fabCustomSize="44.0dip"
                                app:maxImageSize="24.0dip"
                                app:pressedTranslationZ="0.0dip"
                                app:srcCompat="@drawable/ic_add_24"
                                app:tint="?colorOnPrimary" />
                        </LinearLayout>
                        <TextView
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:ellipsize="end"
                            android:id="@id/textStatus"
                            android:visibility="gone"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8.0dip"
                            android:maxLines="2" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip">
        <TextView
            android:id="@id/textVersionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="" />
        <TextView
            android:id="@id/textSelectedVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/selected_instance_empty" />
        <com.google.android.material.button.MaterialButton
            android:id="@id/buttonLaunchVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/button_launch_version"
            android:insetTop="0.0dip"
            android:insetBottom="0.0dip"
            android:elevation="0.0dip"
            android:stateListAnimator="@null" />
        <com.google.android.material.button.MaterialButton
            android:id="@id/buttonOpenFolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/button_open_folder"
            android:insetTop="0.0dip"
            android:insetBottom="0.0dip"
            android:elevation="0.0dip"
            android:stateListAnimator="@null" />
        <TextView
            android:id="@id/textAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name" />
        <TextView
            android:id="@id/textAccountStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_signed_out" />
        <com.google.android.material.button.MaterialButton
            android:id="@id/buttonSignIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/button_sign_in"
            android:insetTop="0.0dip"
            android:insetBottom="0.0dip"
            android:elevation="0.0dip"
            android:stateListAnimator="@null" />
        <com.google.android.material.button.MaterialButton
            android:id="@id/buttonSignOut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/button_sign_out"
            android:insetTop="0.0dip"
            android:insetBottom="0.0dip"
            android:elevation="0.0dip"
            android:stateListAnimator="@null" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@id/switchShowSharedInstalls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@id/textSharedInstallsSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@id/textFolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@id/textRenderSurfaceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@id/switchUseNativeSurface"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@id/textRenderSurfaceSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <CheckBox
            android:id="@id/checkKeepLogs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</FrameLayout>