<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    android:id="@id/scrollProjectDetailsRoot"
    android:background="?android:colorBackground"
    android:padding="16.0dip"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:fillViewport="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="24.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="22.0dip"
            app:cardUseCompatPadding="true">
            <LinearLayout
                android:orientation="vertical"
                android:padding="16.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@id/imageProjectDetailsIcon"
                        android:background="?android:selectableItemBackground"
                        android:padding="2.0dip"
                        android:layout_width="72.0dip"
                        android:layout_height="72.0dip"
                        android:src="@mipmap/ic_launcher"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/content_browser_project_icon_description" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        android:layout_marginStart="14.0dip">
                        <TextView
                            android:textSize="22.0sp"
                            android:textStyle="bold"
                            android:textColor="?android:textColorPrimary"
                            android:ellipsize="end"
                            android:id="@id/textProjectDetailsTitle"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/project_details_loading"
                            android:maxLines="2" />
                        <TextView
                            android:textSize="13.0sp"
                            android:textColor="?android:textColorSecondary"
                            android:id="@id/textProjectDetailsMeta"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4.0dip"
                            android:lineSpacingExtra="1.0dip" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@id/buttonProjectDetailsBack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/project_details_back"
                        android:layout_marginStart="10.0dip"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>
                <TextView
                    android:textSize="13.0sp"
                    android:textColor="?android:textColorSecondary"
                    android:id="@id/textProjectDetailsStatus"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12.0dip"
                    android:text="@string/project_details_loading" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12.0dip">
                    <com.google.android.material.button.MaterialButton
                        android:id="@id/buttonOpenProjectWebsite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/project_details_website" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.tabs.TabLayout
            android:id="@id/tabProjectDetailsSections"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.0dip"
            app:tabGravity="fill"
            app:tabMode="fixed" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/sectionProjectDescription"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12.0dip"
                app:cardCornerRadius="22.0dip"
                app:cardUseCompatPadding="true">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="18.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@id/imageProjectDetailsMainImage"
                        android:background="?android:selectableItemBackground"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="190.0dip"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/project_details_image_description" />
                    <TextView
                        android:textSize="15.0sp"
                        android:textColor="?android:textColorPrimary"
                        android:id="@id/textProjectDetailsDescription"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14.0dip"
                        android:lineSpacingExtra="3.0dip" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/sectionProjectVersions"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12.0dip"
                app:cardCornerRadius="20.0dip"
                app:cardUseCompatPadding="true">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14.0sp"
                        android:textColor="?android:textColorSecondary"
                        android:id="@id/textProjectDetailsVersionFilterSummary"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/project_details_loading_versions" />
                    <TextView
                        android:textSize="12.0sp"
                        android:textStyle="bold"
                        android:textColor="?android:textColorSecondary"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12.0dip"
                        android:text="@string/project_details_minecraft_version" />
                    <com.google.android.material.button.MaterialButton
                        android:gravity="start|center"
                        android:id="@id/buttonProjectDetailsMinecraftVersion"
                        android:layout_width="fill_parent"
                        android:layout_height="48.0dip"
                        android:layout_marginTop="4.0dip"
                        android:text="@string/project_details_all_minecraft_versions"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_arrow_drop_down_24"
                        app:iconGravity="textEnd"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12.0dip">
                        <com.google.android.material.button.MaterialButton
                            android:id="@id/buttonProjectDetailsVersionPrevious"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/project_details_previous"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                        <TextView
                            android:textSize="13.0sp"
                            android:textColor="?android:textColorSecondary"
                            android:gravity="center"
                            android:id="@id/textProjectDetailsVersionPageIndicator"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:text="@string/project_details_page_default"
                            android:layout_weight="1.0"
                            android:layout_marginStart="12.0dip"
                            android:layout_marginEnd="12.0dip" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@id/buttonProjectDetailsVersionNext"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/project_details_next"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@id/recyclerProjectVersions"
                android:clipToPadding="false"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/sectionProjectGallery"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14.0sp"
                android:textColor="?android:textColorSecondary"
                android:id="@id/textProjectDetailsGallery"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14.0dip" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@id/recyclerProjectGallery"
                android:clipToPadding="false"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>