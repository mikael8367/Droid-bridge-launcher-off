<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:fillViewport="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="40.0dip"
        android:paddingBottom="40.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="520.0dip"
        android:paddingStart="28.0dip"
        android:paddingEnd="28.0dip">
        <TextView
            android:textSize="30.0sp"
            android:textStyle="bold"
            android:id="@id/textTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/droidbridge" />
        <TextView
            android:textSize="22.0sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@id/textInstallerHeading"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30.0dip"
            android:text="@string/component_installer_checking_title" />
        <TextView
            android:textSize="16.0sp"
            android:gravity="center"
            android:id="@id/textInstallerDescription"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14.0dip"
            android:text="@string/component_installer_checking_message"
            android:lineSpacingExtra="3.0dip" />
        <TextView
            android:textSize="14.0sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@id/textInstallerStorage"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18.0dip"
            android:text="@string/component_installer_storage_advice" />
        <ProgressBar
            android:id="@id/progressComponents"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26.0dip"
            android:indeterminate="true"
            style="?android:progressBarStyleHorizontal" />
        <TextView
            android:textSize="14.0sp"
            android:gravity="center"
            android:id="@id/textStatus"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14.0dip"
            android:text="@string/splash_screen_checking" />
        <TextView
            android:textSize="14.0sp"
            android:id="@id/textMissingComponents"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18.0dip"
            android:lineSpacingExtra="2.0dip" />
        <com.google.android.material.button.MaterialButton
            android:textSize="16.0sp"
            android:id="@id/buttonInstallComponents"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26.0dip"
            android:minHeight="52.0dip"
            android:text="@string/component_installer_install_button"
            android:textAllCaps="false"
            app:cornerRadius="16.0dip" />
        <com.google.android.material.button.MaterialButton
            android:textSize="15.0sp"
            android:id="@id/buttonContinueLauncher"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip"
            android:minHeight="50.0dip"
            android:text="@string/component_installer_continue_button"
            android:textAllCaps="false"
            app:cornerRadius="16.0dip"
            style="?materialButtonOutlinedStyle" />
    </LinearLayout>
</ScrollView>