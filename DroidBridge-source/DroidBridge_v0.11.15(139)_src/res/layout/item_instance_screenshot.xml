<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    android:focusable="true"
    android:clickable="true"
    android:layout_width="fill_parent"
    android:layout_height="170.0dip"
    android:layout_margin="5.0dip"
    android:foreground="?selectableItemBackground"
    app:cardBackgroundColor="?colorSurfaceVariant"
    app:cardCornerRadius="16.0dip"
    app:cardElevation="1.0dip"
    app:cardUseCompatPadding="false"
    app:strokeColor="?colorOutlineVariant"
    app:strokeWidth="1.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <ImageView
            android:id="@id/imageScreenshotThumbnail"
            android:background="#12000000"
            android:padding="2.0dip"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:scaleType="centerCrop"
            android:adjustViewBounds="false"
            android:contentDescription="@string/instance_screenshot_thumbnail_generic_description" />
        <ProgressBar
            android:layout_gravity="center"
            android:id="@id/progressScreenshotThumbnail"
            android:layout_width="32.0dip"
            android:layout_height="32.0dip"
            android:indeterminate="true" />
        <TextView
            android:textSize="12.0sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:ellipsize="middle"
            android:layout_gravity="bottom"
            android:id="@id/textScreenshotName"
            android:background="#b3000000"
            android:paddingTop="7.0dip"
            android:paddingBottom="7.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingStart="10.0dip"
            android:paddingEnd="10.0dip" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>