<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:background="@android:color/black"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/imageScreenshotFullscreen"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@string/instance_screenshot_fullscreen_description" />
    <ProgressBar
        android:layout_gravity="center"
        android:id="@id/progressScreenshotFullscreen"
        android:layout_width="48.0dip"
        android:layout_height="48.0dip"
        android:indeterminate="true" />
    <com.google.android.material.button.MaterialButton
        android:layout_gravity="start|center|top"
        android:id="@id/buttonScreenshotBack"
        android:padding="0.0dip"
        android:layout_width="52.0dip"
        android:layout_height="52.0dip"
        android:layout_marginTop="16.0dip"
        android:minWidth="52.0dip"
        android:minHeight="52.0dip"
        android:contentDescription="@string/instance_screenshot_back"
        android:layout_marginStart="16.0dip"
        app:backgroundTint="#cc1b1b1f"
        app:icon="@drawable/ic_arrow_back_24"
        app:iconGravity="textStart"
        app:iconPadding="0.0dip"
        app:iconTint="@android:color/white"
        style="@style/Widget.Material3.Button.TextButton.Icon" />
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom|center"
        android:orientation="horizontal"
        android:background="@drawable/bg_screenshot_viewer_controls"
        android:padding="6.0dip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20.0dip"
        android:layout_marginStart="12.0dip"
        android:layout_marginEnd="12.0dip">
        <com.google.android.material.button.MaterialButton
            android:textColor="@android:color/white"
            android:id="@id/buttonScreenshotShare"
            android:layout_width="wrap_content"
            android:layout_height="48.0dip"
            android:minWidth="0.0dip"
            android:minHeight="48.0dip"
            android:text="@string/instance_screenshot_share"
            app:icon="@drawable/ic_share_24"
            app:iconTint="@android:color/white"
            style="@style/Widget.Material3.Button.TextButton" />
        <com.google.android.material.button.MaterialButton
            android:textColor="@android:color/white"
            android:id="@id/buttonScreenshotDownload"
            android:layout_width="wrap_content"
            android:layout_height="48.0dip"
            android:minWidth="0.0dip"
            android:minHeight="48.0dip"
            android:text="@string/instance_screenshot_download"
            android:layout_marginStart="2.0dip"
            app:icon="@drawable/ic_download_24"
            app:iconTint="@android:color/white"
            style="@style/Widget.Material3.Button.TextButton" />
        <com.google.android.material.button.MaterialButton
            android:textColor="@android:color/white"
            android:id="@id/buttonScreenshotDelete"
            android:layout_width="wrap_content"
            android:layout_height="48.0dip"
            android:minWidth="0.0dip"
            android:minHeight="48.0dip"
            android:text="@string/instance_screenshot_delete"
            android:layout_marginStart="2.0dip"
            app:icon="@drawable/ic_delete_24"
            app:iconTint="@android:color/white"
            style="@style/Widget.Material3.Button.TextButton" />
    </LinearLayout>
</FrameLayout>